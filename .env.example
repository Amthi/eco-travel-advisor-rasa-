AMADEUS_API_KEY=your_amadeus_client_id_here
AMADEUS_API_SECRET=your_amadeus_client_secret_here
OPENCAGE_API_KEY=your_opencage_api_key_here
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here
HUMAN_ADVISOR_ENDPOINT=https://internal.example.com/advisor/handover
